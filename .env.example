DATABASE_URL=postgres://recallloop:recallloop@127.0.0.1:5432/recallloop
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Leave LLM_API_KEY empty to use deterministic mock mode.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Grounded remediation uses deterministic local providers by default.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
REMEDIATION_PROVIDER=mock
