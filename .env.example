DATABASE_URL=postgres://recallloop:recallloop@127.0.0.1:5432/recallloop
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Local development defaults: deterministic providers, no credentials required.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Grounding stays deterministic in mock mode.
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
REMEDIATION_PROVIDER=mock

# Gemini real-provider example: replace the mock provider/model/key values above with these.
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# REMEDIATION_PROVIDER=llm

# LLM_PROVIDER controls study concept extraction and free-form answer evaluation.
# EMBEDDING_PROVIDER controls grounding-source ingestion and retrieval.
# REMEDIATION_PROVIDER=llm uses the LLM provider for schema-validated, source-grounded text;
# mock selects deterministic extractive remediation. Question generation remains built-in.
