{
  "name": "recallloop",
  "private": true,
  "version": "0.1.0",
  "description": "Adaptive active-recall learning system",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server",
    "test:e2e": "node client/tests/e2e/knowledge-roadmap.mjs",
    "test:assessment-loop": "node scripts/run-isolated-assessment-loop.mjs",
    "question-bank:activate": "node scripts/activate-question-bank-review.mjs",
    "start": "npm run start -w server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "geckodriver": "^5.0.0",
    "selenium-webdriver": "4.25.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
