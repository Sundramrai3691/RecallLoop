{
  "name": "recallloop-server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "question-bank:audit": "tsx src/scripts/questionBankWorkflow.ts inventory --write",
    "question-bank:review:export": "tsx src/scripts/questionBankWorkflow.ts review-export",
    "question-bank:review:validate": "tsx src/scripts/questionBankWorkflow.ts review-validate",
    "question-bank:review:import": "tsx src/scripts/questionBankWorkflow.ts review-import",
    "question-bank:activation-report": "tsx src/scripts/questionBankWorkflow.ts activation-report",
    "question-bank:benchmark": "tsx src/scripts/questionBankWorkflow.ts benchmark-report",
    "question-bank:benchmark:export": "tsx src/scripts/questionBankWorkflow.ts benchmark-export",
    "question-bank:benchmark:import": "tsx src/scripts/questionBankWorkflow.ts benchmark-import",
    "question-bank:review:export-domain": "tsx src/scripts/questionBankWorkflow.ts review-export-domain",
    "question-bank:automated-review": "tsx src/scripts/automatedQuestionReview.ts",
    "question-bank:seed:dbms": "tsx src/scripts/seedDbmsCoreQuestions.ts",
    "question-bank:coverage": "tsx src/scripts/coreSdeCoverage.ts",
    "db:import-legacy": "tsx ../scripts/migrate-mongo-to-postgres.ts",
    "config:check": "tsx src/scripts/checkConfig.ts",
    "test:providers:live": "vitest run src/services/providers/providerSmoke.live.test.ts --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=verbose --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "htmlparser2": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jszip": "^3.10.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
